# MCPForge environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# Values here are variable names and non-secret defaults ONLY.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
MCPFORGE_ENV=development           # development | staging | production
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Backend service (services/api) — SERVER ONLY, never exposed to the browser
# ─────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Gemini — official google-genai SDK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2

# Firebase Admin (backend token verification + Firestore)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=      # absolute path to a service account json, kept outside the repo

# GitHub App — scoped, per-repository installation
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=         # absolute path to the .pem, kept outside the repo
GITHUB_APP_WEBHOOK_SECRET=

# Secure execution
SECURE_EXECUTOR=development          # development | confidential_space
WORKSPACE_ROOT=/tmp/mcpforge-workspaces
JOB_TIMEOUT_SECONDS=600
JOB_MEMORY_MB=2048
JOB_MAX_OUTPUT_BYTES=10485760

# Confidential Space (Phase 8 — leave empty until real infrastructure exists)
GCP_PROJECT_ID=
CONFIDENTIAL_SPACE_IMAGE_DIGEST=
ATTESTATION_AUDIENCE=

# Indexing limits
INDEX_MAX_FILE_BYTES=262144
INDEX_MAX_FILES=20000

# ─────────────────────────────────────────────────────────────
# Web app (apps/web)
# Only NEXT_PUBLIC_* reaches the browser. Never put a secret here.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase web config — public by design
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Which auth providers are actually configured. Unlisted providers render disabled.
NEXT_PUBLIC_AUTH_PROVIDERS=google

# Dev-only: opt in to the labelled mock WebMCP adapter. Must be false/absent in production builds.
NEXT_PUBLIC_WEBMCP_MOCK=false

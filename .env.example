# MCPForge environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# Values here are variable names and non-secret defaults ONLY.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
MCPFORGE_ENV=development           # development | staging | production
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Backend service (services/api) — SERVER ONLY, never exposed to the browser
# ─────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Gemini — official google-genai SDK. Two ways to authenticate; pick one.
#
#   GEMINI_BACKEND=api_key   needs GEMINI_API_KEY from aistudio.google.com/apikey.
#                            Current keys start with "AQ." and are ~53 chars.
#                            Older ones start with "AIza". Both are valid — do
#                            not reject a key on its prefix.
#   GEMINI_BACKEND=vertex    needs GOOGLE_CLOUD_PROJECT and Application
#                            Default Credentials. NO SECRET AT ALL — preferred
#                            where policy restricts key material.
#                            Requires: gcloud services enable aiplatform.googleapis.com
GEMINI_BACKEND=api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0

# Identity — PROVISIONAL (Firebase Auth today; likely direct Google OAuth later).
# Backend token verification needs NO credentials: Firebase ID tokens are verified
# against Google's public JWKS by signature, issuer, audience and expiry.
FIREBASE_PROJECT_ID=

# Server-side Google credentials use Application Default Credentials.
# Development:  gcloud auth application-default login
# Production:   the deployment's workload identity
# Service-account key files are NOT supported and must never be created or committed.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# GitHub App — scoped, per-repository installation
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=         # absolute path to the .pem, kept outside the repo
GITHUB_APP_WEBHOOK_SECRET=

# Secure execution
SECURE_EXECUTOR=development          # development | confidential_space
WORKSPACE_ROOT=/tmp/mcpforge-workspaces
JOB_TIMEOUT_SECONDS=600
JOB_MEMORY_MB=2048
JOB_MAX_OUTPUT_BYTES=10485760

# Confidential Space (Phase 8 — leave empty until real infrastructure exists).
#
# NAMES ONLY. Every one of these is empty on purpose: none of this
# infrastructure has been created, nothing here is a secret, and a value in this
# file would be a value in git. See infra/confidential-space/policy.md for what
# each resource is and infra/confidential-space/setup.sh for what creates it.
#
# There is deliberately no service-account key variable. MCPForge supports no
# key file anywhere (03_SECURITY_ACCESS.md §9); workload identity federation is
# the mechanism that replaces one.
GCP_PROJECT_ID=
# The relying party's own pin: the digest a delivered attestation token must
# name. Read by the API (F8-02); never taken from the operator or the workload.
CONFIDENTIAL_SPACE_IMAGE_DIGEST=
ATTESTATION_AUDIENCE=
# The private bucket the workload writes its token to (setup.sh creates it),
# and where the API keeps its issued runs (default ~/.local/state/mcpforge/...).
CONFIDENTIAL_SPACE_ATTESTATION_BUCKET=
CONFIDENTIAL_SPACE_RUN_DIR=

# Workload identity federation — created by infra/confidential-space/setup.sh (F8-02b).
# The pool and provider ids are global resources; the service account is the
# identity an attested workload federates into.
CONFIDENTIAL_SPACE_WORKLOAD_IDENTITY_POOL=
CONFIDENTIAL_SPACE_WORKLOAD_IDENTITY_PROVIDER=
CONFIDENTIAL_SPACE_WORKLOAD_SERVICE_ACCOUNT=
# JWKS endpoint the attestation verifier resolves signing keys from. F8-01
# deliberately has no default: guessing an endpoint inside a security control is
# worse than requiring the value. F8-02's workload does not read this variable:
# it finds the key set from Google's OIDC discovery document at run time.
CONFIDENTIAL_SPACE_ATTESTATION_JWKS_URL=

# Indexing limits
INDEX_MAX_FILE_BYTES=262144
INDEX_MAX_FILES=20000

# ─────────────────────────────────────────────────────────────
# Web app (apps/web)
# Only NEXT_PUBLIC_* reaches the browser. Never put a secret here.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase web config — public by design
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Which auth providers are actually configured. Unlisted providers render disabled.
NEXT_PUBLIC_AUTH_PROVIDERS=google

# Dev-only: opt in to the labelled mock WebMCP adapter. Must be false/absent in production builds.
NEXT_PUBLIC_WEBMCP_MOCK=false
